#!/usr/bin/env bash
# One command: drop takes in input/, write script.txt, run ./edit, get output/*.mp4
# First run installs whatever is missing (Python, Node, FFmpeg, Python + Node packages, Smart-Cut).
set -euo pipefail
cd "$(dirname "$0")"

SMART_CUT_REPO="https://github.com/qkirara/Smart-Cut"
SMART_CUT_COMMIT="5db446382cb6a39c7ac1628803930cdaa0835171"

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

pkg_install() {
  # pkg_install <brew-name> <apt-name>
  if [[ "$(uname)" == "Darwin" ]]; then
    if ! have brew; then
      echo "Homebrew is needed to install $1. Install it from https://brew.sh then re-run ./edit" >&2
      exit 1
    fi
    brew install "$1"
  elif have apt-get; then
    local sudo=""; [[ $EUID -ne 0 ]] && sudo="sudo"
    $sudo apt-get update -qq && $sudo apt-get install -y -qq $2
  elif have dnf; then
    local sudo=""; [[ $EUID -ne 0 ]] && sudo="sudo"
    $sudo dnf install -y $2
  else
    echo "Please install $1 manually, then re-run ./edit" >&2
    exit 1
  fi
}

# --- Python ---------------------------------------------------------------
PY=""
for c in python3.13 python3.12 python3.11 python3.10 python3; do
  if have "$c" && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then PY="$c"; break; fi
done
if [[ -z "$PY" ]]; then
  say "Python 3.9+ not found, installing"
  pkg_install python "python3 python3-venv python3-pip"
  PY=python3
fi

# --- FFmpeg ---------------------------------------------------------------
if ! have ffmpeg || ! have ffprobe; then
  say "FFmpeg not found, installing"
  pkg_install ffmpeg ffmpeg
fi

# --- Node 22+ (HyperFrames needs it) ---------------------------------------
node_ok() { have node && node -e 'process.exit(parseInt(process.versions.node) >= 22 ? 0 : 1)'; }
if ! node_ok; then
  say "Node.js 22+ not found, installing"
  if [[ "$(uname)" == "Darwin" ]]; then
    pkg_install node nodejs
  else
    pkg_install node "nodejs npm"
  fi
  if ! node_ok; then
    echo "Node.js 22 or newer is required (found: $(node -v 2>/dev/null || echo none))." >&2
    echo "Install it with nvm:  curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash && nvm install 22" >&2
    exit 1
  fi
fi

# --- Smart-Cut ------------------------------------------------------------
if [[ ! -f vendor/Smart-Cut/smart_cut.py ]]; then
  say "Cloning Smart-Cut"
  mkdir -p vendor
  git clone -q "$SMART_CUT_REPO" vendor/Smart-Cut
  git -C vendor/Smart-Cut checkout -q "$SMART_CUT_COMMIT" || true
fi

# --- Python packages ------------------------------------------------------
if [[ ! -x .venv/bin/python ]]; then
  say "Creating Python environment"
  "$PY" -m venv .venv
fi
REQ_STAMP=".venv/.requirements.$(cksum < requirements.txt | cut -d' ' -f1)"
if [[ ! -f "$REQ_STAMP" ]]; then
  say "Installing Python packages (faster-whisper)"
  .venv/bin/python -m pip install -q --upgrade pip
  .venv/bin/python -m pip install -q -r requirements.txt
  rm -f .venv/.requirements.* && touch "$REQ_STAMP"
fi

# --- Node packages (HyperFrames, caption font) ----------------------------
PKG_STAMP="node_modules/.pkg.$(cksum < package.json | cut -d' ' -f1)"
if [[ ! -f "$PKG_STAMP" ]]; then
  say "Installing Node packages (HyperFrames)"
  npm install --no-fund --no-audit --silent
  rm -f node_modules/.pkg.* && touch "$PKG_STAMP"
fi

exec .venv/bin/python edit.py "$@"
